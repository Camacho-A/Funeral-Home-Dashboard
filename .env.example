# Beacon environment variables.
# Copy this file to .env.local (gitignored) and fill in real values as needed.
# See docs/WIX_INTEGRATION.md for the full reference, including local/preview/
# production configuration and what each variable actually does today.

# --- Data adapter (docs/WIX_INTEGRATION.md, docs/adr/ADR-007-wix-integration-foundation.md) ---
# Controls DATA access ONLY (which backend services/* read/write against) —
# independent of AUTH_ADAPTER below, which controls login (see
# docs/adr/ADR-011-auth-data-adapter-separation.md for why they were split).
# "mock" (default if unset) — every service reads services/__mocks__/fixtures.ts,
# exactly as it has since Phase 4. No Wix variables below are required in this mode,
# and next build succeeds without any of them set.
# "wix" — reads (organizations today; more in later phases) come from the real
# Wix project. Writes still go to mocks until Phase 16.
DATA_ADAPTER=mock

# --- Auth adapter (docs/AUTHENTICATION.md, docs/adr/ADR-011-auth-data-adapter-separation.md) ---
# Controls AUTHENTICATION ONLY (which login provider app/login uses) —
# independent of DATA_ADAPTER above. Defaults to "mock" for developer
# convenience if unset.
# "mock" — the existing mock login (dana@managedcremations.test / mock-password-not-real).
# "wix" — the existing Wix Members login (lib/auth/wixAuth.ts), requires WIX_OAUTH_CLIENT_ID below.
# "identity" — Beacon's own email/password identity system (Phase 21, docs/adr/ADR-025-identity-authentication-architecture.md),
# requires MFA_ENCRYPTION_KEY below only if MFA is used.
# Recommended local development combination: DATA_ADAPTER=wix, AUTH_ADAPTER=mock
# (real Wix-backed data, without needing a real Wix member account yet).
AUTH_ADAPTER=mock

# --- Wix Headless, self-managed (docs/WIX_INTEGRATION.md) ---
# Required only when DATA_ADAPTER=wix. WIX_API_KEY is a secret — server-side only,
# never exposed to the browser (see lib/wixClient.ts). Generate it yourself in the
# Wix dashboard's API Keys manager; Claude does not create or handle this value.
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# --- Compliance/document service: Postgres + object storage (docs/ARCHITECTURE.md) — not used yet ---
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Session (docs/AUTHENTICATION.md) ---
# The signing key for Beacon's own session cookie (lib/auth/sessionToken.ts).
# Falls back to a fixed, clearly-insecure development value outside production
# (see lib/env.ts's getSessionSecret) so mock mode needs nothing set here — but
# a real, random value is required in production, and the app refuses to start
# without one there.
SESSION_JWT_SECRET=

# --- Identity system MFA (docs/adr/ADR-025-identity-authentication-architecture.md) ---
# AES-256-GCM key encrypting TOTP secrets at rest (lib/identity/mfaSecretEncryption.ts).
# Only relevant when AUTH_ADAPTER=identity. Same fallback behavior as
# SESSION_JWT_SECRET: a fixed, clearly-insecure development value outside
# production, a hard failure in production if unset.
MFA_ENCRYPTION_KEY=

# --- Wix Headless member login (docs/AUTHENTICATION.md) ---
# Required only when AUTH_ADAPTER=wix. No client secret is needed —
# headless member OAuth uses only a Client ID. Not created by Claude; see
# docs/AUTHENTICATION.md's "Wix dashboard setup" section, which was
# presented for approval, not acted on.
WIX_OAUTH_CLIENT_ID=

# --- Clover Hosted Checkout (docs/adr/ADR-022-clover-hosted-checkout-integration.md) ---
# Manor's Cremation's paymentIntegrations row (Wix) names these three env
# vars as merchantIdReference/credentialReference/webhookSecretReference —
# set all three and flip isEnabled to true to activate the SANDBOX
# integration. Never commit real values here; this file only reserves the
# names. A future production PaymentIntegration row must reference a
# SEPARATE set of variable names (e.g. CLOVER_MANORS_PRODUCTION_*) — never
# these sandbox ones — so activating production can never accidentally
# run against sandbox credentials or vice versa.
CLOVER_MANORS_SANDBOX_MERCHANT_ID=
CLOVER_MANORS_SANDBOX_PRIVATE_KEY=
CLOVER_MANORS_SANDBOX_WEBHOOK_SECRET=

# --- Platform administration (docs/adr/ADR-024-organization-onboarding-tenant-provisioning.md) ---
# Comma-separated list of user ids (mock ids or real Wix member `_id`s)
# allowed to create a brand-new organization via POST /api/onboarding/start.
# Deliberately minimal — no granular platform-roles system exists; this is
# the one env-var-driven allowlist gating that one action. Empty/unset
# means no one can create a new tenant (safe default).
PLATFORM_ADMIN_USER_IDS=

# --- Real notification delivery (docs/adr/ADR-037-real-notification-delivery.md) ---
# Resend backs BOTH the mandatory identity messages (lib/identity/messageSender.ts —
# password reset, invitations, etc.) and preference-respecting staff/family
# notifications (services/notifications/emailChannel.ts). A configured
# RESEND_API_KEY wins regardless of NODE_ENV, so a developer can opt into real
# sending locally too — leave unset to keep using the dev console adapter
# (logs to the server console, never a real inbox). RESEND_FROM_ADDRESS
# defaults to "Beacon <notifications@beacon.app>" if unset.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Twilio backs the SMS notification channel (services/notifications/smsChannel.ts),
# staff-only (Identity.phone), never family/portal recipients this phase. All
# three must be set together to activate real sending; same dev-console
# fallback behavior as Resend above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Bearer secret Vercel Cron sends on its scheduled call to
# POST /api/cron/notification-digest (app/api/cron/notification-digest/route.ts),
# which flushes digest-batched/quiet-hours-deferred email notifications every
# 15 minutes (see vercel.json). Unset means the route always rejects — safe
# default; no digest/quiet-hours email is ever silently dropped, it just stays
# queued until this is configured.
CRON_SECRET=

# --- Scheduling integrations: calendar sync & reminders (docs/adr/ADR-038-scheduling-integrations-calendar-sync-and-reminders.md) ---
# Google Calendar OAuth (calendar.events + calendar.readonly scopes). Required only
# to activate the "Connect Google" flow; leave unset and that flow surfaces a clear
# "not configured" error rather than a code failure. No client credentials exist in
# this environment — never live-verified against a real Google authorization screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft 365 / Outlook OAuth (Calendars.ReadWrite + offline_access scopes),
# registered as multi-tenant + personal. Same activation story as Google above —
# unset means "Connect Microsoft" surfaces a clear "not configured" error.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# AES-256-GCM key encrypting calendarConnections.accessTokenCiphertext/
# refreshTokenCiphertext at rest (lib/identity/calendarTokenEncryption.ts).
# Deliberately separate from MFA_ENCRYPTION_KEY below — no secret-class key in this
# codebase is ever shared across unrelated secret classes. Same fallback behavior:
# a fixed, clearly-insecure development value outside production, a hard failure
# in production if unset.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# CRON_SECRET (above) is reused, unchanged, for both new Phase 34 cron routes
# (POST /api/cron/appointment-reminders, POST /api/cron/calendar-sync) — no
# second cron secret was introduced.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mock organization used throughout this frontend-only phase ---
# See docs/adr/ADR-002-multi-tenant-architecture.md. Every service call is scoped by
# organizationId; this is the single value used until a second organization exists.
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=managed-cremations
